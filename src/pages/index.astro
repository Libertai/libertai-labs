---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const spans = [
  "md:col-span-7",
  "md:col-span-5",
  "md:col-span-5",
  "md:col-span-7",
  "md:col-span-6",
  "md:col-span-6",
];

const stats = [
  { value: "9", label: "model repos" },
  { value: "24,000+", label: "downloads" },
  { value: "5", label: "base models" },
];

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Base
  title="LibertAI Labs"
  description="Model releases, benchmarks, agent experiments and infrastructure writeups from the team building private, decentralized AI."
>
  <section class="relative overflow-hidden border-b border-white/5">
    <img
      src="/hero.png"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-right"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-night-900 from-25% via-night-900/80 to-night-900/10"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <div class="max-w-xl">
        <h1
          class="font-display text-4xl leading-[1.08] tracking-tight text-mist-100 sm:text-5xl"
        >
          Open research from the LibertAI team
        </h1>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-mist-300">
          Model releases, benchmarks, agent experiments and infrastructure
          writeups, published as we build private, decentralized AI.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#projects"
            class="rounded-full bg-violet-500 px-5 py-2.5 text-sm font-semibold text-white transition-transform active:scale-[0.98]"
          >
            See the projects
          </a>
          <a
            href="#notes"
            class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-mist-100 transition-colors hover:border-white/30"
          >
            Read the notes
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-24">
    <h2 class="font-display text-3xl tracking-tight text-mist-100">Projects</h2>
    <p class="mt-3 max-w-2xl text-mist-400">
      Some of these are in production behind api.libertai.io, and some exist to
      answer a question. The status badge tells you which is which.
    </p>
    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-12">
      {
        projects.map((project, i) => (
          <ProjectCard project={project} class={spans[i % spans.length]} />
        ))
      }
    </div>
  </section>

  <section class="border-y border-white/5 bg-night-800/40">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_auto]"
    >
      <div>
        <h2 class="font-display text-3xl tracking-tight text-mist-100">
          Open weights on Hugging Face
        </h2>
        <p class="mt-3 max-w-xl text-mist-400">
          Quantized builds of the open models we serve, published under
          LibertAIDAI with benchmark numbers in every model card. Counts are
          from June 2026.
        </p>
        <a
          href="https://huggingface.co/LibertAIDAI"
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-mist-100 transition-colors hover:border-white/30"
        >
          View on Hugging Face&nbsp;&#8599;
        </a>
      </div>
      <dl class="flex gap-10 sm:gap-14">
        {
          stats.map((stat) => (
            <div>
              <dd class="font-display text-4xl tracking-tight text-blush-200">
                {stat.value}
              </dd>
              <dt class="mt-1 text-sm text-mist-500">{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="notes" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-24">
    <h2 class="font-display text-3xl tracking-tight text-mist-100">Notes</h2>
    <p class="mt-3 max-w-2xl text-mist-400">
      Writeups with methodology, the numbers that held up, and the ones that
      did not.
    </p>
    <div class="mt-6">
      {
        notes.map((note) => (
          <a
            href={`/notes/${note.id}`}
            class="group grid gap-1 border-b border-white/8 py-7 md:grid-cols-[10rem_1fr] md:gap-6"
          >
            <time
              datetime={note.data.date.toISOString()}
              class="pt-1 text-sm text-mist-500"
            >
              {dateFormat.format(note.data.date)}
            </time>
            <div>
              <h3 class="font-display text-xl tracking-tight text-mist-100 transition-colors group-hover:text-violet-300">
                {note.data.title}
              </h3>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-mist-400">
                {note.data.summary}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
