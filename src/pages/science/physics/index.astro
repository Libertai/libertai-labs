---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";

const physics = (await getCollection("papers"))
  .filter((paper) => paper.data.field === "Physics" && paper.data.publishedAt)
  .sort(
    (a, b) =>
      b.data.date.valueOf() - a.data.date.valueOf() ||
      a.data.title.localeCompare(b.data.title),
  );

const bySlug = new Map(physics.map((paper) => [paper.id, paper]));

const groups = [
  {
    label: "Chronology",
    title: "Time machines and chronology protection",
    body: "What quantum fields do on the Ori and Xavier cores, and whether the standard divergence survives the true horizon.",
    slugs: ["protection-without-teeth", "xavier-analysis"],
  },
  {
    label: "Constructive program",
    title: "Initial data, analogues, acquisition and engineering",
    body: "The composite dust construction, the BEC analogue design study, the acquisition argument and the engineering ledger.",
    slugs: ["hybrid-construction", "bec-analog", "acquisition", "engineering-ledger"],
  },
  {
    label: "Synthesis",
    title: "A critical review of the programme",
    body: "One map of the no-go results, constructive models, computed stress, searches, acquisition and engineering questions.",
    slugs: ["review"],
  },
  {
    label: "Searches",
    title: "Observational relic searches",
    body: "The gravitational-wave and Gaia channels for a boost-holonomy relic, with calibrated nulls and stated limits.",
    slugs: ["relic-survey", "gaia-survey"],
  },
];

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const statusLabel: Record<string, string> = {
  draft: "Draft",
  preprint: "Preprint",
  published: "Published",
};
---

<Base
  title="Physics | LibertAI Labs"
  description="Physics research from LibertAI Labs: chronology protection, explicit time-machine initial data, a BEC analogue, engineering limits and relic searches."
>
  <section class="relative overflow-hidden border-b border-white/8">
    <div
      class="pointer-events-none absolute -top-48 -right-40 h-[42rem] w-[42rem] rounded-full blur-3xl"
      style="background: radial-gradient(circle at 50% 50%, rgba(100,77,249,0.34) 0%, rgba(100,77,249,0.12) 30%, transparent 68%);"
      aria-hidden="true"
    >
    </div>
    <div class="grain-overlay" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <nav aria-label="Science sections" class="flex flex-wrap items-center gap-2 text-sm">
        <a href="/science" class="rounded-md px-2 py-1 text-mist-500 transition-colors hover:text-mist-100">Science</a>
        <span aria-hidden="true" class="text-mist-600">/</span>
        <span class="rounded-md bg-violet-300/10 px-2 py-1 font-semibold text-violet-300" aria-current="page">Physics</span>
        <a href="/science/ai" class="rounded-md px-2 py-1 text-mist-500 transition-colors hover:text-mist-100">AI</a>
        <a href="/priority" class="ml-auto rounded-md px-2 py-1 text-mist-500 transition-colors hover:text-mist-100">Priority registry &rarr;</a>
      </nav>
      <p class="section-label mt-12">Physics</p>
      <h1 class="mt-4 max-w-3xl text-balance font-display text-5xl leading-[1.02] text-white sm:text-7xl">
        Causality, quantum fields, and the geometry of time.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mist-300">
        The physics program tests the edges of general relativity and quantum
        field theory: chronology protection on exact time machines, explicit
        initial data for a composite machine, a BEC analogue, and the
        gravitational-wave and Gaia searches for a natural relic.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#papers" class="rounded-lg bg-violet-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-violet-400">
          Read the papers
        </a>
        <a href="/priority" class="rounded-lg border border-white/15 px-5 py-2.5 text-sm font-semibold text-mist-100 transition-colors hover:border-white/30 hover:bg-white/5">
          Timestamps and DOIs
        </a>
      </div>
      <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-6">
        <div>
          <dd class="font-display text-3xl text-mist-100">{physics.length}</dd>
          <dt class="section-label mt-1">Physics papers</dt>
        </div>
        <div class="border-l border-white/10 pl-10">
          <dd class="font-display text-3xl text-mist-100">4</dd>
          <dt class="section-label mt-1">Research tracks</dt>
        </div>
        <div class="border-l border-white/10 pl-10">
          <dd class="font-display text-3xl text-mist-100">UTC</dd>
          <dt class="section-label mt-1">Public timestamps</dt>
        </div>
      </dl>
    </div>
  </section>

  <section id="papers" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6 sm:py-20">
    <div class="space-y-16">
      {
        groups.map((group) => (
          <div>
            <div class="max-w-2xl">
              <p class="section-label">{group.label}</p>
              <h2 class="mt-3 font-display text-3xl text-mist-100">{group.title}</h2>
              <p class="mt-3 text-mist-400">{group.body}</p>
            </div>
            <div class="mt-8 grid gap-4 lg:grid-cols-2">
              {group.slugs.map((slug) => {
                const paper = bySlug.get(slug);
                if (!paper) return null;
                return (
                  <article class="flex h-full flex-col rounded-xl border border-white/10 bg-night-900/75 p-6 transition-colors hover:border-violet-300/30 hover:bg-night-800/75">
                    <div class="flex flex-wrap items-center gap-2 text-xs text-mist-500">
                      <time datetime={paper.data.date.toISOString()}>{dateFormat.format(paper.data.date)}</time>
                      <span aria-hidden="true">/</span>
                      <span class="rounded-full border border-white/15 bg-white/5 px-2 py-0.5 uppercase tracking-wide">
                        {statusLabel[paper.data.status]}
                      </span>
                    </div>
                    <h3 class="mt-3 font-display text-xl leading-tight text-mist-100">
                      <a href={`/papers/${paper.id}`} class="transition-colors hover:text-cyan-200">
                        {paper.data.title}
                      </a>
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-mist-400">{paper.data.summary}</p>
                    <div class="mt-auto flex flex-wrap gap-4 pt-5 text-sm font-semibold">
                      <a href={`/papers/${paper.id}`} class="text-cyan-200 hover:text-mist-100">
                        Paper &rarr;
                      </a>
                      {paper.data.pdf && (
                        <a href={paper.data.pdf} class="text-cyan-200 hover:text-mist-100">
                          PDF &nbsp;&#8599;
                        </a>
                      )}
                      {paper.data.doi && (
                        <a href={`https://doi.org/${paper.data.doi}`} target="_blank" rel="noopener" class="text-cyan-200 hover:text-mist-100">
                          DOI &nbsp;&#8599;
                        </a>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-white/8 bg-night-900/50">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="section-label">Method</p>
        <h2 class="mt-3 font-display text-3xl text-mist-100">Preprints, limits and repairs are public.</h2>
        <p class="mt-3 max-w-2xl text-mist-400">
          These are preprints, not peer-reviewed claims. Each paper states its
          assumptions, its losses, and what remains open. The priority registry
          carries the first-public timestamp and the SHA-256 of the PDF served here.
        </p>
      </div>
      <a href="/priority" class="inline-flex rounded-lg border border-white/15 px-5 py-2.5 text-sm font-semibold text-mist-100 transition-colors hover:border-white/30 hover:bg-white/5">
        Open the registry &rarr;
      </a>
    </div>
  </section>
</Base>
