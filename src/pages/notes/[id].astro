---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, summary, date } = note.data;

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base title={`${title} | LibertAI Labs`} description={summary}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a
      href="/#notes"
      class="text-sm text-mist-500 transition-colors hover:text-mist-100"
    >
      &larr; All notes
    </a>
    <time
      datetime={date.toISOString()}
      class="mt-8 block text-sm text-mist-500"
    >
      {dateFormat.format(date)}
    </time>
    <h1 class="mt-3 font-display text-4xl leading-[1.15] tracking-tight text-mist-100">
      {title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-mist-300">{summary}</p>
    <hr class="my-10 border-white/8" />
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
