---
// Native, on-brand recreation of the Conscio self-report line charts.
// qwen (violet) + deepseek (teal) across architecture rungs B0–B4.
interface Props {
  title: string;
  series: { qwen: number[]; deepseek: number[] };
  labelPoints?: { i: number; series: "qwen" | "deepseek"; above?: boolean }[];
}
const { title, series, labelPoints = [] } = Astro.props;

const rungs = ["B0", "B1", "B2", "B3", "B4"];
const PL = 34;
const PR = 348;
const PT = 18;
const PB = 188;
const W = PR - PL;
const H = PB - PT;
const x = (i: number) => PL + (i / (rungs.length - 1)) * W;
const y = (v: number) => PT + (1 - v / 100) * H;
const yTicks = [0, 25, 50, 75, 100];

const QWEN = "#8a78ff";
const TEAL = "#00d2c9";
const path = (vals: number[]) =>
  vals.map((v, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(" ");
---

<figure class="m-0">
  <p class="mb-3 text-center text-sm font-medium text-mist-300">{title}</p>
  <svg viewBox="0 0 360 210" fill="none" class="h-auto w-full" role="img" aria-label={title}>
    {
      yTicks.map((t) => (
        <g>
          <line x1={PL} y1={y(t)} x2={PR} y2={y(t)} stroke="#ffffff" stroke-opacity="0.06" />
          <text x={PL - 6} y={y(t) + 3.5} text-anchor="end" font-family="Satoshi, sans-serif" font-size="9.5" fill="#5a7a78">
            {t}%
          </text>
        </g>
      ))
    }
    {
      rungs.map((r, i) => (
        <text x={x(i)} y={PB + 16} text-anchor="middle" font-family="Satoshi, sans-serif" font-size="10" fill="#7d9794">
          {r}
        </text>
      ))
    }

    <path d={path(series.qwen)} stroke={QWEN} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d={path(series.deepseek)} stroke={TEAL} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

    {series.qwen.map((v, i) => <circle cx={x(i)} cy={y(v)} r="3" fill="#0c1a18" stroke={QWEN} stroke-width="1.5" />)}
    {series.deepseek.map((v, i) => <circle cx={x(i)} cy={y(v)} r="3" fill="#0c1a18" stroke={TEAL} stroke-width="1.5" />)}

    {
      labelPoints.map((lp) => {
        const v = series[lp.series][lp.i];
        return (
          <text
            x={x(lp.i)}
            y={y(v) + (lp.above ? -8 : 15)}
            text-anchor="middle"
            font-family="Satoshi, sans-serif"
            font-size="10"
            font-weight="500"
            fill={lp.series === "qwen" ? "#ab9eff" : "#5ff4ec"}
          >
            {v}%
          </text>
        );
      })
    }
  </svg>
</figure>
