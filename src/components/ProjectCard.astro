---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  class?: string;
}

const { project, class: className = "" } = Astro.props;
const { title, summary, status, image, imageAlt } = project.data;

const badgeStyles: Record<string, string> = {
  shipped: "border-violet-500/40 bg-violet-500/10 text-violet-300",
  experiment: "border-white/15 text-mist-400",
  research: "border-blush-200/30 bg-blush-200/5 text-blush-200",
};
---

<a
  href={`/projects/${project.id}`}
  class={`group flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-night-800/60 transition-all duration-200 hover:-translate-y-0.5 hover:border-white/20 ${className}`}
>
  {
    image && (
      <div class="border-b border-white/8">
        <img
          src={image}
          alt={imageAlt ?? ""}
          loading="lazy"
          class="aspect-[21/9] w-full object-cover object-top"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-4">
      <h3 class="font-display text-xl tracking-tight text-mist-100">{title}</h3>
      <span
        class={`shrink-0 rounded-full border px-2.5 py-0.5 text-xs ${badgeStyles[status]}`}
      >
        {status}
      </span>
    </div>
    <p class="mt-3 text-sm leading-relaxed text-mist-400">{summary}</p>
    <span class="mt-auto pt-5 text-sm text-violet-300 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
      Read more
    </span>
  </div>
</a>
