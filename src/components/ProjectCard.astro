---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  class?: string;
}

const { project, class: className = "" } = Astro.props;
const { title, summary, status, image, imageAlt } = project.data;

const statusMeta: Record<string, { label: string; class: string }> = {
  shipped: {
    label: "Shipped",
    class: "border-sage-300/35 bg-sage-300/10 text-sage-200",
  },
  experiment: {
    label: "Experiment",
    class: "border-cyan-300/35 bg-cyan-300/10 text-cyan-200",
  },
  research: {
    label: "Research",
    class: "border-blush-200/35 bg-blush-200/10 text-blush-200",
  },
};

const meta = statusMeta[status];
---

<a
  href={`/projects/${project.id}`}
  aria-label={`Read ${title}`}
  class={`group flex h-full flex-col overflow-hidden rounded-lg border border-white/10 bg-night-900/75 transition-all duration-200 hover:-translate-y-0.5 hover:border-white/25 hover:bg-night-800/75 ${className}`}
>
  {
    image && (
      <div class="border-b border-white/8">
        <img
          src={image}
          alt={imageAlt ?? ""}
          loading="lazy"
          class="aspect-[16/7] w-full object-cover object-top"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <h3 class="font-display text-xl leading-tight text-mist-100">{title}</h3>
      <span
        class={`shrink-0 rounded-full border px-2.5 py-0.5 text-xs ${meta.class}`}
      >
        {meta.label}
      </span>
    </div>
    <p class="mt-3 text-sm leading-relaxed text-mist-400">{summary}</p>
    <span class="mt-auto pt-6 text-sm font-semibold text-cyan-200 transition-colors group-hover:text-mist-100">
      Read project -&gt;
    </span>
  </div>
</a>
