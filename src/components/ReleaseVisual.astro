---
// Layered "release preview" illustration for the featured NVFP4 release:
// a floating throughput benchmark (NVFP4 vs stock) with a tensor die behind
// it for depth, plus floating spec pills. Pure SVG, brand gradients only.
---

<svg
  viewBox="0 0 560 380"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class="relative h-auto w-full max-w-[30rem]"
  role="img"
  aria-label="NVFP4 throughput benchmark preview: NVFP4 builds running faster than stock K-quants on Blackwell"
>
  <defs>
    <linearGradient id="rv-bar" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#0a8f89"></stop>
      <stop offset="1" stop-color="#00d2c9"></stop>
    </linearGradient>
    <radialGradient id="rv-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#00d2c9" stop-opacity="0.45"></stop>
      <stop offset="1" stop-color="#00d2c9" stop-opacity="0"></stop>
    </radialGradient>
    <filter id="rv-soft" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="16"></feGaussianBlur>
    </filter>
  </defs>

  <ellipse cx="225" cy="200" rx="160" ry="125" fill="url(#rv-glow)" filter="url(#rv-soft)"></ellipse>

  <!-- depth: tensor die behind the main card -->
  <g class="rv-die">
    <rect x="320" y="58" width="180" height="156" rx="14" fill="#0a1614" stroke="#143a37"></rect>
    <rect x="362" y="70" width="60" height="20" rx="10" fill="#071210" stroke="#0a5a55"></rect>
    <text x="392" y="84" text-anchor="middle" font-family="Satoshi, sans-serif" font-size="11" font-weight="700" fill="#5ff4ec">NVFP4</text>
    <g>
      <rect x="362" y="104" width="22" height="22" rx="3" fill="#0f3b38"></rect>
      <rect x="389" y="104" width="22" height="22" rx="3" fill="#00d2c9" fill-opacity="0.55"></rect>
      <rect x="416" y="104" width="22" height="22" rx="3" fill="#1a1648" stroke="#2c2470"></rect>
      <rect x="443" y="104" width="22" height="22" rx="3" fill="#0f3b38"></rect>
      <rect x="470" y="104" width="22" height="22" rx="3" fill="#003e3c" stroke="#005958"></rect>
      <rect x="362" y="131" width="22" height="22" rx="3" fill="#1a1648" stroke="#2c2470"></rect>
      <rect x="389" y="131" width="22" height="22" rx="3" fill="#0f3b38"></rect>
      <rect x="416" y="131" width="22" height="22" rx="3" fill="#00d2c9" fill-opacity="0.4"></rect>
      <rect x="443" y="131" width="22" height="22" rx="3" fill="#0f3b38"></rect>
      <rect x="470" y="131" width="22" height="22" rx="3" fill="#1a1648" stroke="#2c2470"></rect>
      <rect x="362" y="158" width="22" height="22" rx="3" fill="#003e3c" stroke="#005958"></rect>
      <rect x="389" y="158" width="22" height="22" rx="3" fill="#1a1648" stroke="#2c2470"></rect>
      <rect x="416" y="158" width="22" height="22" rx="3" fill="#0f3b38"></rect>
      <rect x="443" y="158" width="22" height="22" rx="3" fill="#00d2c9" fill-opacity="0.5"></rect>
      <rect x="470" y="158" width="22" height="22" rx="3" fill="#0f3b38"></rect>
    </g>
  </g>

  <!-- soft shadow under the main card -->
  <rect x="48" y="92" width="312" height="212" rx="18" fill="#000000" fill-opacity="0.4" filter="url(#rv-soft)"></rect>

  <!-- main benchmark card -->
  <rect x="48" y="84" width="312" height="208" rx="18" fill="#0c1a18" stroke="#1d4a45"></rect>

  <!-- header -->
  <circle cx="72" cy="108" r="3.5" fill="#5a7a78"></circle>
  <circle cx="84" cy="108" r="3.5" fill="#34504d"></circle>
  <circle cx="96" cy="108" r="3.5" fill="#34504d"></circle>
  <text x="338" y="112" text-anchor="end" font-family="Satoshi, sans-serif" font-size="10" font-weight="700" letter-spacing="1.2" fill="#5a7a78">THROUGHPUT · TOK/S</text>

  <!-- gridlines -->
  <line x1="70" y1="252" x2="338" y2="252" stroke="#ffffff" stroke-opacity="0.12"></line>
  <line x1="70" y1="216" x2="338" y2="216" stroke="#ffffff" stroke-opacity="0.05"></line>
  <line x1="70" y1="180" x2="338" y2="180" stroke="#ffffff" stroke-opacity="0.05"></line>

  <!-- bars: stock (muted) vs NVFP4 (teal) across three models -->
  <g>
    <rect x="92" y="190" width="24" height="62" rx="4" fill="#24403d"></rect>
    <rect class="rv-bar" x="120" y="156" width="24" height="96" rx="4" fill="url(#rv-bar)"></rect>

    <rect x="170" y="198" width="24" height="54" rx="4" fill="#24403d"></rect>
    <rect class="rv-bar" x="198" y="148" width="24" height="104" rx="4" fill="url(#rv-bar)"></rect>

    <rect x="248" y="182" width="24" height="70" rx="4" fill="#24403d"></rect>
    <rect class="rv-bar" x="276" y="140" width="24" height="112" rx="4" fill="url(#rv-bar)"></rect>
  </g>

  <!-- highlight value on the strongest NVFP4 bar -->
  <rect x="266" y="112" width="44" height="22" rx="11" fill="#00d2c9" fill-opacity="0.14" stroke="#00d2c9" stroke-opacity="0.5"></rect>
  <text x="288" y="127" text-anchor="middle" font-family="Satoshi, sans-serif" font-size="12" font-weight="700" fill="#5ff4ec">1.9×</text>

  <!-- legend -->
  <rect x="92" y="270" width="10" height="10" rx="2" fill="#24403d"></rect>
  <text x="108" y="279" font-family="Satoshi, sans-serif" font-size="11" fill="#7d9794">Stock K-quant</text>
  <rect x="206" y="270" width="10" height="10" rx="2" fill="#00d2c9"></rect>
  <text x="222" y="279" font-family="Satoshi, sans-serif" font-size="11" fill="#7d9794">NVFP4</text>

  <!-- floating spec pills -->
  <g>
    <rect x="56" y="48" width="104" height="28" rx="14" fill="#0c1a18" stroke="#ffffff" stroke-opacity="0.12"></rect>
    <circle cx="74" cy="62" r="3.5" fill="#00d2c9"></circle>
    <text x="86" y="66" font-family="Satoshi, sans-serif" font-size="12" font-weight="500" fill="#c2c4d4">Blackwell</text>
  </g>
  <g>
    <rect x="96" y="306" width="150" height="28" rx="14" fill="#0c1a18" stroke="#ffffff" stroke-opacity="0.12"></rect>
    <circle cx="114" cy="320" r="3.5" fill="#644df9"></circle>
    <text x="126" y="324" font-family="Satoshi, sans-serif" font-size="12" font-weight="500" fill="#c2c4d4">GGUF · safetensors</text>
  </g>
</svg>

<style is:global>
  .rv-bar {
    transform-box: fill-box;
    transform-origin: bottom;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rv-die {
    transition: transform 0.45s ease;
  }
  .group:hover .rv-bar {
    transform: scaleY(1.07);
  }
  .group:hover .rv-bar:nth-of-type(2) {
    transition-delay: 0.05s;
  }
  .group:hover .rv-bar:nth-of-type(3) {
    transition-delay: 0.1s;
  }
  .group:hover .rv-die {
    transform: translate(7px, -5px);
  }
</style>
